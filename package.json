{
    "name": "minizinc-playground",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "format:check": "prettier -c .",
        "format": "prettier -w .",
        "build": "vite build && npm run build:embed",
        "build:embed": "vite build --mode library",
        "preview": "vite preview",
        "dev": "node scripts/dev.js",
        "dev:app": "vite",
        "dev:embed": "vite build --mode library --watch --outDir .vite-embed",
        "test:unit": "vitest run --project unit",
        "test:components": "vitest run --project components",
        "test": "npm run test:unit && npm run test:components",
        "test:watch": "vitest",
        "test:ui": "vitest --ui"
    },
    "devDependencies": {
        "@lezer/generator": "^1.8.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@vitest/ui": "^4.1.11",
        "jsdom": "^30.0.1",
        "minizinc": "^4.5.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "sass": "^1.103.1",
        "svelte": "^5.56.10",
        "vite": "^8.2.2",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-json": "^6.0.2",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@lezer/highlight": "^1.2.3",
        "@lezer/lr": "^1.4.10",
        "bulma": "^1.0.4",
        "codemirror": "^6.0.2",
        "file-saver": "^2.0.5",
        "jszip": "^3.10.1",
        "lodash": "^4.18.1",
        "split.js": "^1.6.5",
        "svelte-fa": "^4.0.4",
        "thememirror": "^2.0.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.1": true
    }
}
